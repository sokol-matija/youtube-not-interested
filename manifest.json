{
  "manifest_version": 3,
  "name": "YouTube Quick Not Interested",
  "version": "1.1",
  "description": "X to mark Not Interested. Auto-hides homepage videos already in your Watch Later.",
  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "host_permissions": ["*://*.youtube.com/*", "http://localhost:7777/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Block",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["lib/storage.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
