{
  "manifest_version": 3,
  "name": "YouTube Quick Not Interested",
  "version": "1.3.0",
  "description": "X to mark Not Interested. Auto-hides homepage videos already in your Watch Later.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:7777/*",
    "http://localhost:7779/*",
    "http://sokol.falcon-parore.ts.net:8880/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Quick Block — Settings",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "lib/storage.js",
        "lib/bridge.js",
        "lib/markdown.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "lib/autopip.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+9",
        "mac": "Command+Shift+9"
      },
      "description": "Toggle picture-in-picture on the playing YouTube video",
      "global": true
    }
  }
}
